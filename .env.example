# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is listed in .gitignore - it is never committed. Only this .example file is.

POSTGRES_DB=flowforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=FlowForge
JWT_AUDIENCE=FlowForgeUsers

# AI features (task breakdown, assignee suggestion, project summaries) are optional -
# leave OPENAI_API_KEY blank and the app just disables them. Get a free key from
# https://openrouter.ai/keys, and check https://openrouter.ai/models?max_price=0 for
# what's currently free before picking a model (the free catalog rotates over time).
# Leave OPENAI_BASE_URL blank to use real OpenAI instead of an OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_MODEL=google/gemma-4-31b-it:free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Comma separated. If the main model is rate limited or unavailable, these are tried in order.
OPENAI_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

# Email. Defaults send to MailHog (http://localhost:8025), which catches mail and delivers nothing.
# For real delivery use any SMTP provider, e.g. Gmail with an app password:
# EMAIL_SMTP_HOST=smtp.gmail.com, EMAIL_SMTP_PORT=587, EMAIL_ENABLE_SSL=true
EMAIL_SMTP_HOST=mailhog
EMAIL_SMTP_PORT=1025
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@flowforge.local
